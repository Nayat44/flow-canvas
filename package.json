{
  "name": "flow-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "A flow map that lives inside the app it documents — Claude Code skill plus a portable React Flow implementation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install-skills": "./install.sh",
    "demo": "vite --config demo/vite.config.ts",
    "demo:capture": "cd demo && node ../skills/flow-canvas/scripts/capture-screens.mjs flow-canvas.shots.mjs public/flow-canvas/screens",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "python3 skills/flow-canvas/scripts/validate.py demo/public/flow-canvas/flows.json"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.11.0",
    "html-to-image": "^1.11.13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
